# Các key sau đều TUỲ CHỌN. Không điền vào file này trên GitHub.
# Thêm vào: GitHub repo → Settings → Secrets and variables → Actions → New repository secret

# CoinGecko Demo API key (miễn phí, giảm rủi ro bị giới hạn tần suất): https://www.coingecko.com/en/api
COINGECKO_DEMO_KEY=

# FRED API key (miễn phí): https://fred.stlouisfed.org/docs/api/api_key.html
# Không có key vẫn chạy được qua file CSV công khai của FRED.
FRED_API_KEY=
